{
  "name": "@minesweeper-flags/signaling",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "prebuild": "npm run build -w @minesweeper-flags/game-engine -w @minesweeper-flags/shared",
    "build": "tsc -b tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "pretest": "npm run build -w @minesweeper-flags/game-engine -w @minesweeper-flags/shared",
    "test": "vitest run --passWithNoTests src",
    "pretypecheck": "npm run build -w @minesweeper-flags/game-engine -w @minesweeper-flags/shared",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@minesweeper-flags/shared": "*",
    "redis": "^6.3.0"
  },
  "license": "MIT"
}
