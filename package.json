{
  "name": "minesweeper-flags",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "packages/game-engine",
    "packages/shared",
    "apps/server",
    "apps/signaling",
    "apps/client"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "concurrently -k -n server,client -c yellow,cyan \"npm run dev -w @minesweeper-flags/server\" \"npm run dev -w @minesweeper-flags/client\"",
    "format": "biome check --write --diagnostic-level=warn .",
    "lint": "biome check --error-on-warnings --diagnostic-level=warn .",
    "prepare": "husky",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.1",
    "husky": "9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "17.6.0",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "license": "MIT"
}
