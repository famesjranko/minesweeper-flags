# Type-checks and tests the working tree before a push. CI runs the full
# make check on the pushed commit; this hook only catches failures earlier.
if [ ! -x node_modules/.bin/tsc ]; then
  echo "pre-push: dependencies are not installed in this worktree. Run: npm install" >&2
  exit 1
fi

head=$(git rev-parse HEAD)
pushes_head=false
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  # Peel annotated tags to their commit, so a tag at HEAD counts as HEAD.
  if [ "$local_sha" != 0000000000000000000000000000000000000000 ]; then
    local_sha=$(git rev-parse "$local_sha^{commit}" 2>/dev/null || echo "$local_sha")
  fi
  case "$local_sha" in
    0000000000000000000000000000000000000000) ;; # a deleted ref has nothing to check
    "$head") pushes_head=true ;;
    *)
      echo "pre-push: skipped local checks, because the pushed commit is not HEAD. CI still runs make check." >&2
      exit 0
      ;;
  esac
done

if [ "$pushes_head" = false ]; then
  exit 0
fi

# Untracked files count too: a test can pass locally on a file the commit lacks.
if [ -n "$(git status --porcelain)" ]; then
  echo "pre-push: the working tree has uncommitted or untracked files, so it is not the commit you push." >&2
  echo "pre-push: commit, remove, or ignore them, then push again." >&2
  exit 1
fi

make typecheck test || {
  echo "pre-push: fix the failures above. Run them again with: make typecheck test" >&2
  exit 1
}
