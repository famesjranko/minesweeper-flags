{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/package-lock.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        // noUncheckedIndexedAccess makes every grid lookup possibly undefined; the
        // engine asserts after its own bounds checks.
        "noNonNullAssertion": "off",
        // Reordering selectors in styles.css changes the cascade.
        "noDescendingSpecificity": "off"
      }
    }
  },
  "overrides": [
    {
      // These tests assert Docker Compose interpolation text, not template literals.
      "includes": ["**/public-compose.test.ts"],
      "linter": { "rules": { "suspicious": { "noTemplateCurlyInString": "off" } } }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "none"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
